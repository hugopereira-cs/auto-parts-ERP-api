{
	"name": "auto-parts-ERP-api",
	"version": "1.0.0",
	"description": "REST API for an ERP-style system, built with Node.js and Express, for an auto parts store (personal portfolio project).",
	"main": "index.js",
	"scripts": {
		"start": "tsx --env-file=.env src/server.ts",
		"dev": "tsx watch --env-file=.env src/server.ts",
		"clean": "rm -rf dist coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome ci .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "tsx --env-file=.env prisma/seed.ts",
		"prepare": "husky"
	},
	"keywords": [
		"node",
		"typescript"
	],
	"author": "",
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/supertest": "^7.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"supertest": "^7.3.2",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"dotenv": "^18.0.10",
		"express": "^5.3.0",
		"zod": "^4.6.7"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
